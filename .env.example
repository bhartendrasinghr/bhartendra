# Password required to sign in at /admin
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie (use a long random string)
ADMIN_SECRET=replace-with-a-long-random-secret

# Optional. When set, the admin reads/writes content from Vercel Blob instead of
# the local filesystem. On Vercel this is added automatically when you connect a
# Blob store, so you normally do NOT set it by hand. Leave unset for local dev.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
